{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "Markista",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista"
        },

        {
            "type": "java",
            "name": "Markista - Options",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc.options"],
        },
        {
            "type": "java",
            "name": "Markista - DocService",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc.options"],
            "modulePaths": [
                "${workspaceFolder}/markista/build/classes/java/main",
                "${workspaceFolder}/../markista.docagrams/markista.docagrams/build/libs/markista.docagrams.jar"
            ]
        },

        {
            "type": "java",
            "name": "Marksita - Module",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-mod.options"]
        },

        {
            "type": "java",
            "name": "Example - module",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-example2.options"]
        },

        {
            "type": "java",
            "name": "Example - no module-info",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-example3.options"]
        },

        {
            "type": "java",
            "name": "Example - no package-info",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-example4.options"]
        },

        {
            "type": "java",
            "name": "Food Example",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-example.options"]
        },

        {
            "type": "java",
            "name": "Consumer",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-consumer.options"]
        },

        {
            "type": "java",
            "name": "Food",
            "request": "launch",
            "mainClass": "markista/io.github.sandydunlop.markista.doclet.MarkdownDoclet",
            "projectName": "markista",
            "args": ["-options", "javadoc-food.options"]
        },

        {
            "type": "java",
            "name": "Debug (Attach)",
            "projectName": "markista",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        }
    ]    
}