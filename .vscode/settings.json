{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.debug.settings.onBuildFailureProceed": true,
    "cSpell.words": [
        "doclet",
        "jacoco",
        "markista",
        "mdautolink",
        "NOSONAR",
        "prefs",
        "sandydunlop",
        "sonarqube",
        "Supertypes"
    ],
    "java.test.config": [
    {
      "name": "MyTestConfig",
      "modulePaths": [
        "${workspaceFolder}/bin/main",
        "${workspaceFolder}/module/"
      ],
      "coverageReport": {
        "enabled": true,
        "reportPath": "**/build/reports/jacoco/test/jacocoTestReport.xml",
        "sourcePaths": [
          "${workspaceFolder}/src/main/java"
        ]
      }
    }
  ],
  "coverage-gutters.coverageFileNames": [
      
      "markista/build/reports/jacoco/test/jacocoTestReport.xml",
      "lcov.info",
      "cov.xml",
      "coverage.xml",
      "cobertura.xml",
      "jacoco.xml",
      "coverage.cobertura.xml",
  ],
  "testing.alwaysRevealTestOnStateChange": true,
  "testing.coverageToolbarEnabled": true,

  "java.completion.importOrder": [
    "io",
    "",
    "java",
    "javax",
    "",
    "jdk",
    "sun",
    "",
    "#"
  ],
 "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
}